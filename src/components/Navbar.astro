---

---

<header
  data-navbar
  class="fixed top-0 left-0 right-0 z-50 py-5 px-8 text-white"
>
  <nav class="flex items-center justify-between container mx-auto">
    <!-- Logo -->
    <a
      data-navbar-logo
      href="#"
      class="text-xl font-bold tracking-tight text-neutral-900"
    >
      MoviGas
    </a>

    <!-- Nav links + Social icons -->
    <div class="flex items-center gap-10">
      <!-- Navigation Links -->
      <ul class="flex items-center gap-8">
        <li>
          <a
            href="#"
            class="nav-link text-sm font-bold hover:text-red-900 transition-colors"
          >
            Inicio
          </a>
        </li>
        <li>
          <a
            href="#"
            class="nav-link text-sm font-bold hover:text-red-900 transition-colors"
          >
            Servicios
          </a>
        </li>
        <li>
          <a
            href="#"
            class="nav-link text-sm font-bold hover:text-red-900 transition-colors"
          >
            Nosotros
          </a>
        </li>
        <li>
          <a
            href="#"
            class="nav-link text-sm font-bold hover:text-red-900 transition-colors"
          >
            Contacto
          </a>
        </li>
      </ul>

      <!-- Divider -->
      <div class="w-px h-4 bg-neutral-300"></div>

      <!-- Social Icons -->
      <div class="flex items-center gap-4">
        <!-- Instagram -->
        <a
          href="#"
          class="social-icon text-inherit hover:text-neutral-900 transition-colors"
          aria-label="Instagram"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>

        <!-- Facebook -->
        <a
          href="#"
          class="social-icon text-inherit hover:text-neutral-900 transition-colors"
          aria-label="Facebook"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
            ></path>
          </svg>
        </a>

        <!-- Twitter / X -->
        <a
          href="#"
          class="social-icon text-inherit hover:text-neutral-900 transition-colors"
          aria-label="Twitter"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  import { gsap, ScrollTrigger } from "../lib/gsap";

  const navbar = document.querySelector("[data-navbar]") as HTMLElement;

  gsap.context(() => {
    // gsap.set(navbar, { backgroundColor: "transparent" });

    const tl = gsap.timeline({
      defaults: { ease: "power3.out" },
      delay: 0.1,
    });

    tl.from("[data-navbar-logo]", { y: -24, opacity: 0, duration: 0.7 })
      .from(
        ".nav-link",
        { y: -16, opacity: 0, duration: 0.5, stagger: 0.08 },
        "-=0.4",
      )
      .from(
        ".social-icon",
        { y: -16, opacity: 0, duration: 0.5, stagger: 0.08 },
        "-=0.3",
      );

    const tl2 = gsap.timeline({ paused: true }).to(navbar, {
      backgroundColor: "#ffffff",
      textColor: "#000000",
      color: "#000000",
      boxShadow: "0 1px 12px rgba(0,0,0,0.08)",
      ease: "none",
    });

    ScrollTrigger.create({
      trigger: document.documentElement,
      animation: tl2,
      start: "10% 20%",
      end: "10% 5%",
      scrub: true,
    });
  }, navbar);
</script>
