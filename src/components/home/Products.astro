---
import ProductCard from "./ProductCard.astro";
import { products } from "../../data/products";
---

<section
  data-products-section
  class="py-24 bg-neutral-700 text-white overflow-hidden"
>
  <div class="container mx-auto md:px-0 px-8">
    <!-- Section header -->
    <div class="mb-20 flex flex-col gap-6">
      <div class="flex flex-col gap-4">
        <span
          data-products-label
          class="text-xs uppercase tracking-[0.3em] text-neutral-400 font-medium"
        >
          Lo que ofrecemos
        </span>
        <h2
          data-products-heading
          class="text-6xl font-bold leading-none tracking-tight"
        >
          Nuestros Productos
        </h2>
      </div>
      <p
        data-products-subtitle
        class="text-base text-neutral-400 leading-relaxed max-w-xl md:mb-2 text-balance"
      >
        Abastecemos y brindamos soluciones a distintas industrias químicas,
        alimenticias y agroindustriales; comercializando y distribuyendo
        Amoníaco anhídro a granel y agua amoniacal.
      </p>
    </div>

    <!-- Products grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-6">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, SplitText } from "../../lib/gsap";

  const section = document.querySelector(
    "[data-products-section]",
  ) as HTMLElement;

  gsap.context(() => {
    // --- Split text elements ---
    const headingEl = section.querySelector(
      "[data-products-heading]",
    ) as HTMLElement;
    const labelEl = section.querySelector(
      "[data-products-label]",
    ) as HTMLElement;
    const subtitleEl = section.querySelector(
      "[data-products-subtitle]",
    ) as HTMLElement;

    const splitHeading = new SplitText(headingEl, { type: "chars,words" });
    const splitLabel = new SplitText(labelEl, { type: "chars" });
    const splitSubtitle = new SplitText(subtitleEl, { type: "lines" });

    const productNames = section.querySelectorAll("[data-product-name]");
    const splitNames = Array.from(productNames).map(
      (el) => new SplitText(el as HTMLElement, { type: "lines" }),
    );
    const productDescs = section.querySelectorAll("[data-product-desc]");
    const splitDescs = Array.from(productDescs).map(
      (el) => new SplitText(el as HTMLElement, { type: "lines" }),
    );

    // --- Initial states ---
    gsap.set(splitLabel.chars, { opacity: 0, y: 8 });
    gsap.set(splitHeading.chars, { opacity: 0, y: 40, rotateX: -15 });
    gsap.set(splitSubtitle.lines, { opacity: 0, y: 12 });
    gsap.set("[data-product-card]", { opacity: 0, y: 60 });
    gsap.set("[data-product-image]", { scale: 1.05 });
    splitNames.forEach((s) => gsap.set(s.lines, { opacity: 0, y: 16 }));
    splitDescs.forEach((s) => gsap.set(s.lines, { opacity: 0 }));
    gsap.set("[data-product-number]", { opacity: 0 });

    // --- Header timeline ---
    const tlHeader = gsap.timeline({ paused: true });

    tlHeader
      .to(splitLabel.chars, {
        opacity: 1,
        y: 0,
        duration: 0.6,
        stagger: 0.015,
        ease: "power2.out",
      })
      .to(
        splitHeading.chars,
        {
          opacity: 1,
          y: 0,
          rotateX: 0,
          duration: 0.8,
          stagger: 0.02,
          ease: "power3.out",
        },
        "-=0.3",
      )
      .to(
        splitSubtitle.lines,
        {
          opacity: 1,
          y: 0,
          duration: 0.7,
          stagger: 0.1,
          ease: "power2.out",
        },
        "-=0.4",
      );

    ScrollTrigger.create({
      trigger: section,
      start: "top 75%",
      end: "top 30%",
      animation: tlHeader,
      scrub: true,
    });

    // --- Cards timeline ---
    const tlCards = gsap.timeline({ paused: true });

    tlCards.to("[data-product-card]", {
      opacity: 1,
      y: 0,
      duration: 1,
      stagger: 0.15,
      ease: "power3.out",
    });

    tlCards.to(
      "[data-product-image]",
      {
        scale: 1,
        duration: 1.2,
        stagger: 0.15,
        ease: "power3.out",
      },
      "<",
    );

    tlCards.to(
      "[data-product-number]",
      {
        opacity: 1,
        duration: 0.4,
        stagger: 0.15,
        ease: "power2.out",
      },
      "-=0.6",
    );

    splitNames.forEach((s, i) => {
      tlCards.to(
        s.lines,
        {
          opacity: 1,
          y: 0,
          duration: 0.5,
          stagger: 0.08,
          ease: "power2.out",
        },
        `-=${0.5 - i * 0.05}`,
      );
    });

    splitDescs.forEach((s, i) => {
      tlCards.to(
        s.lines,
        {
          opacity: 1,
          duration: 0.5,
          stagger: 0.06,
          ease: "power2.out",
        },
        `-=${0.4 - i * 0.05}`,
      );
    });

    ScrollTrigger.create({
      trigger: "[data-product-card]",
      start: "top 80%",
      end: "bottom 40%",
      animation: tlCards,
      scrub: true,
    });
  }, section);
</script>
