<div class="h-svh">
  <div
    data-hero-container
    class="relative bg-neutral-200 flex flex-col items-center justify-center h-full gap-4 overflow-hidden"
  >
    <video
      class="absolute inset-0 w-full h-full object-cover"
      src="https://res.cloudinary.com/dkgnaegp9/video/upload/v1784671503/537824_Cars_Motorbikes_Grass_Truck_By_Videophilia_Artlist_HD_cmv4of.mp4"
      autoplay
      loop
      muted
      playsinline></video>
    <!-- <div class="absolute inset-0 w-full h-full bg-neutral-800/60"></div> -->
    <div
      class="relative z-10 h-full w-full flex flex-col items-start justify-end p-8 text-neutral-50"
    >
      <div class="w-full flex justify-between items-end">
        <div class="w-2xl" data-hero-text>
          <p class="text-5xl leading-none font-semibold">CALIDAD CERTIFICADA</p>
          <p class="text-5xl mb-4 font-semibold">SERVICIO ASEGURADO</p>
          <p class="text-3xl leading-none font-light text-balance italic">
            Creemos que la mejor manera de ofrecer un buen servicio es enfocarse
            día a día en conseguir la mejor calidad
          </p>
        </div>
        <div>
          <div class="bg-white px-8 py-3 text-neutral-900 font-semibold">
            Ver Servicios
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { gsap, SplitText } from "../../lib/gsap";

  const container = document.querySelector(
    "[data-hero-container]",
  ) as HTMLElement;

  gsap.context(() => {
    const split = new SplitText("[data-hero-text]", {
      type: "chars,words,lines",
    });

    const containerDuration = 1.2;
    const textDelay = containerDuration - 0.5;

    // Set all initial states synchronously before any paint to prevent scroll jumps
    gsap.set(container, { autoAlpha: 0 });
    gsap.set(split.chars, { opacity: 0, y: 20 });

    const tl = gsap.timeline();

    tl.to(container, {
      scale: 1,
      autoAlpha: 1,
      duration: containerDuration,
      ease: "power3.out",
    }).to(
      split.chars,
      {
        opacity: 1,
        y: 0,
        duration: 0.6,
        stagger: 0.02,
        ease: "power2.out",
      },
      textDelay,
    );
  }, container);
</script>
