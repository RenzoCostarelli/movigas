<div class="h-[80svh] md:h-[90svh] px-4">
  <div
    data-hero-container
    class="relative rounded-xl shadow-xl bg-neutral-200 flex flex-col items-center justify-center h-full gap-4 overflow-hidden"
  >
    <video
      class="absolute inset-0 w-full h-full object-cover"
      src="https://res.cloudinary.com/dkgnaegp9/video/upload/v1784671503/537824_Cars_Motorbikes_Grass_Truck_By_Videophilia_Artlist_HD_cmv4of.mp4"
      autoplay
      loop
      muted
      playsinline></video>
    <div
      class="absolute inset-0 w-full h-full bg-linear-to-t from-neutral-900 to-50% to-transparent"
    >
    </div>
    <div
      class="relative container mx-auto z-10 h-full w-full flex flex-col items-start justify-end pl-8 pb-12 md:pl-0 md:pb-24 text-neutral-50"
    >
      <div class="w-full flex justify-between items-end">
        <div class="w-2xl" data-hero-text>
          <p class="text-2xl md:text-5xl leading-none font-semibold">
            CALIDAD CERTIFICADA
          </p>
          <p class="text-2xl md:text-5xl mb-4 font-semibold">
            SERVICIO ASEGURADO
          </p>
          <p class="md:text-3xl leading-none font-light text-balance italic">
            Creemos que la mejor manera de ofrecer un buen servicio es enfocarse
            día a día en conseguir la mejor calidad
          </p>
        </div>
        <div class="flex">
          <a href="#contacto" class="group">
            <a href="#productos" class="group">
              <div
                data-hero-btn
                class="block relative bg-transparent overflow-hidden transition-colors duration-500 shadow-[-1px_-1px_0.5px_0px_rgba(255,255,255,0.55),1px_1px_0.5px_0px_rgba(255,255,255,0.25)] text-neutral-50 rounded-md px-8 py-3 font-black"
              >
                <span
                  data-btn-glow
                  class="absolute h-full w-full inset-0 bg-radial from-white blur-xl to-transparent rounded-full opacity-0 group-hover:opacity-40 group-hover:translate-y-5.5 translate-y-7.5 translate-x-16 transition-all duration-500"
                ></span>
                <span data-hero-btn-text class="relative"
                  >Nuestros Productos</span
                >
              </div>
            </a>
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { gsap, SplitText } from "../../lib/gsap";

    const container = document.querySelector(
      "[data-hero-container]",
    ) as HTMLElement;

    gsap.context(() => {
      const heroTextEl = container.querySelector(
        "[data-hero-text]",
      ) as HTMLElement;
      const split = new SplitText(heroTextEl, { type: "chars,words" });

      const containerDuration = 1.2;
      const textDelay = containerDuration - 0.5;

      gsap.set(container, { autoAlpha: 0, scale: 0.97 });
      gsap.set(split.chars, { opacity: 0, y: 20 });

      const tl = gsap.timeline();

      tl.to(container, {
        scale: 1,
        autoAlpha: 1,
        duration: containerDuration,
        ease: "power3.out",
      }).to(
        split.chars,
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          stagger: 0.02,
          ease: "power2.out",
        },
        textDelay,
      );

      const btnEl = container.querySelector("[data-hero-btn]") as HTMLElement;
      const btnTextEl = container.querySelector(
        "[data-hero-btn-text]",
      ) as HTMLElement;
      const splitBtn = new SplitText(btnTextEl, { type: "chars" });

      const BASE_WEIGHT = 200;
      const MAX_WEIGHT = 900;
      const RADIUS = 80;

      const weightFns = splitBtn.chars.map((char) =>
        gsap.quickTo(char, "fontWeight", {
          duration: 0.35,
          ease: "power3.out",
        }),
      );

      btnEl.addEventListener("mousemove", (e: MouseEvent) => {
        splitBtn.chars.forEach((char, i) => {
          const rect = char.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          const dist = Math.sqrt((e.clientX - cx) ** 2 + (e.clientY - cy) ** 2);
          const proximity = Math.max(0, 1 - dist / RADIUS);
          weightFns[i](BASE_WEIGHT + (MAX_WEIGHT - BASE_WEIGHT) * proximity);
        });
      });

      btnEl.addEventListener("mouseleave", () => {
        weightFns.forEach((fn) => fn(BASE_WEIGHT));
      });
    }, container);
  </script>
</div>
