<div class="h-[80svh] md:h-[85svh] px-4 overflow-hidden">
  <div
    data-hero-container
    class="relative rounded-xl shadow-xl bg-neutral-200 flex overflow-hidden flex-col items-center justify-center h-full gap-4"
  >
    <video
      class="absolute inset-0 w-full h-full object-cover"
      src="https://res.cloudinary.com/dkgnaegp9/video/upload/v1788470054/Portada_WEB_2_vr3vx2.mp4"
      autoplay
      loop
      muted
      playsinline
      data-hero-video></video>
    <div
      class="absolute rounded-xl inset-0 w-full h-full bg-linear-to-t from-neutral-900 to-50% to-transparent"
    >
    </div>
    <div
      class="relative container mx-auto z-10 h-full w-full flex flex-col items-start justify-end pb-12 px-5 md:pl-0 md:pb-24 text-neutral-50"
    >
      <div class="w-full flex flex-col gap-12 justify-between items-start">
        <div class="w-full max-w-2xl">
          <h1 data-hero-title class="flex flex-col">
            <span class="text-2xl md:text-5xl leading-none"
              >CALIDAD CERTIFICADA</span
            >
            <span class="text-2xl md:text-5xl mb-4 font-semibold"
              >SERVICIO ASEGURADO</span
            >
          </h1>
          <p
            class="md:text-xl leading-none font-extralight italic"
            data-hero-text
          >
            Creemos que la mejor manera de ofrecer un buen servicio es enfocarse
            día a día en conseguir la mejor calidad.
          </p>
        </div>
        <div class="flex">
          <a
            href="#productos"
            class="mt-6 inline-block bg-neutral-50 border border-neutral-900 text-sm px-6 py-3 w-max font-bold text-neutral-950 hover:text-red-700 transition-colors"
          >
            Ver nuestros productos
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { gsap, SplitText } from "../../lib/gsap";

    const container = document.querySelector(
      "[data-hero-container]",
    ) as HTMLElement;
    gsap.context(() => {
      const heroVideoEl = container.querySelector(
        "[data-hero-video]",
      ) as HTMLVideoElement;
      const heroTitleEl = container.querySelector(
        "[data-hero-title]",
      ) as HTMLElement;
      const heroTextEl = container.querySelector(
        "[data-hero-text]",
      ) as HTMLElement;

      const splitTitle = new SplitText(heroTitleEl, { type: "lines" });
      const splitText = new SplitText(heroTextEl, { type: "words" });

      const containerDuration = 1.2;
      const titleDelay = containerDuration - 0.5;

      gsap.set(heroVideoEl, { autoAlpha: 0, scale: 0.75 });
      gsap.set(splitTitle.lines, { yPercent: 110, opacity: 0 });
      gsap.set(splitText.words, { yPercent: 110, opacity: 0 });
      gsap.set(heroTitleEl, { overflow: "hidden" });
      gsap.set(heroTextEl, { overflow: "hidden" });

      const tl = gsap.timeline();

      tl.to(heroVideoEl, {
        scale: 1,
        autoAlpha: 1,
        duration: containerDuration,
        ease: "power3.out",
      })
        .to(
          splitTitle.lines,
          {
            opacity: 1,
            yPercent: 0,
            duration: 0.7,
            stagger: 0.15,
            ease: "power2.out",
          },
          titleDelay,
        )
        .to(
          splitText.words,
          {
            opacity: 1,
            yPercent: 0,
            duration: 0.5,
            stagger: 0.04,
            ease: "power2.out",
          },
          ">-0.3",
        );
    }, container);
  </script>
</div>
