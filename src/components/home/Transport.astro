---
const transportList = [
  { text: "Transporte de GLP (Butano - Propano)", accent: true },
  { text: "Transporte de combustibles", accent: false },
  { text: "Transporte de Fertilizantes", accent: false },
  { text: "Transporte de Amoniaco", accent: true },
];

const thumbs = [
  {
    id: 1,
    alt: "Flota de transporte 1",
    src: "https://res.cloudinary.com/dkgnaegp9/image/upload/v1787154397/DSC01208_mrrrqv.jpg",
  },
  {
    id: 2,
    alt: "Flota de transporte 2",
    src: "https://res.cloudinary.com/dkgnaegp9/image/upload/v1787154397/DSC01203_bzoaa9.jpg",
  },
  {
    id: 3,
    alt: "Flota de transporte 3",
    src: "https://res.cloudinary.com/dkgnaegp9/image/upload/v1787154397/DSC01181_ca3def.jpg",
  },
];
---

<section
  data-services-section
  class="py-24 bg-white text-neutral-900 overflow-hidden"
>
  <div class="container mx-auto px-6 md:px-0">
    <h2
      data-services-heading
      class="text-left font-bold text-5xl md:text-7xl leading-[1.05] tracking-tight mb-4"
    >
      Nuestra Flota
    </h2>

    <div class="max-w-2xl text-left mb-8">
      <p
        data-services-body
        class="text-base text-neutral-600 leading-relaxed text-pretty"
      >
        Contamos con la estructura técnica y operativa necesaria para resolver
        las más variadas alternativas de operativos de logísticas y
        abastecimiento a nivel nacional e internacional, posicionándonos dentro
        de las más importantes empresas prestadoras del servicio de transporte
        de cargas peligrosas.
      </p>
    </div>

    <div
      data-transport-carousel
      class="flex md:grid md:grid-cols-3 gap-4 md:gap-6 overflow-x-auto md:overflow-visible snap-x snap-mandatory md:snap-none"
    >
      {
        thumbs.map((thumb) => (
          <img
            data-services-thumb
            src={thumb.src}}
            class="min-w-[76%] md:min-w-0 shrink-0 md:shrink snap-start aspect-4/3 bg-neutral-100 rounded-lg overflow-hidden"
            aria-label={thumb.alt}
          />
        ))
      }
    </div>
    <h2
      data-services-heading
      class="text-center font-bold text-3xl md:text-5xl leading-[1.05] tracking-tight mb-4 mt-8"
    >
      Conductores y Operadores
    </h2>
    <div class="max-w-2xl mx-auto text-left">
      <p
        data-services-body
        class="text-base text-center text-neutral-600 leading-relaxed text-pretty"
      >
        El plantel de choferes posee los conocimientos, capacitaciones, exámenes
        psicofísicos y habilitaciones solicitadas para el transporte de cargas
        peligrosas y generales exigidos y requeridos por cada una de las
        distintas actividades desarrolladas.
      </p>
    </div>
  </div>
</section>

<style>
  [data-transport-carousel] {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  [data-transport-carousel]::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  import { gsap, ScrollTrigger, SplitText } from "../../lib/gsap";

  const section = document.querySelector(
    "[data-services-section]",
  ) as HTMLElement;

  gsap.context(() => {
    const headings = gsap.utils.toArray<HTMLElement>("[data-services-heading]");
    const bodies = gsap.utils.toArray<HTMLElement>("[data-services-body]");
    const thumbs = gsap.utils.toArray<HTMLElement>("[data-services-thumb]");
    const carouselEl = section.querySelector(
      "[data-transport-carousel]",
    ) as HTMLElement;

    const splitHeading = new SplitText(headings[0], { type: "chars,words" });
    const splitBody = new SplitText(bodies[0], { type: "lines" });
    const splitHeading2 = new SplitText(headings[1], { type: "words" });
    const splitBody2 = new SplitText(bodies[1], { type: "lines" });

    // --- Initial states ---
    gsap.set(splitHeading.chars, { opacity: 0, y: 30, rotateX: -15 });
    gsap.set(splitBody.lines, { opacity: 0, y: 12 });
    gsap.set(thumbs, { opacity: 0, y: 40 });
    gsap.set(splitHeading2.words, { opacity: 0, y: 20 });
    gsap.set(splitBody2.lines, { opacity: 0 });

    // --- Header timeline ---
    const tlHeader = gsap.timeline({ paused: true });

    tlHeader
      .to(splitHeading.chars, {
        opacity: 1,
        y: 0,
        rotateX: 0,
        duration: 0.8,
        stagger: 0.02,
        ease: "power3.out",
      })
      .to(
        splitBody.lines,
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          stagger: 0.08,
          ease: "power2.out",
        },
        "-=0.3",
      );

    ScrollTrigger.create({
      trigger: section,
      start: "top 75%",
      end: "top 25%",
      animation: tlHeader,
      scrub: true,
    });

    // --- Carousel timeline ---
    const tlCarousel = gsap.timeline({ paused: true });

    tlCarousel.to(thumbs, {
      opacity: 1,
      y: 0,
      duration: 0.8,
      stagger: 0.15,
      ease: "power3.out",
    });

    ScrollTrigger.create({
      trigger: carouselEl,
      start: "top 80%",
      end: "top 30%",
      animation: tlCarousel,
      scrub: true,
    });

    // --- Secondary content timeline ---
    const tlSecondary = gsap.timeline({ paused: true });

    tlSecondary
      .to(splitHeading2.words, {
        opacity: 1,
        y: 0,
        duration: 0.6,
        stagger: 0.05,
        ease: "power3.out",
      })
      .to(
        splitBody2.lines,
        {
          opacity: 1,
          duration: 0.5,
          stagger: 0.08,
          ease: "power2.out",
        },
        "-=0.2",
      );

    ScrollTrigger.create({
      trigger: headings[1],
      start: "top 80%",
      end: "top 30%",
      animation: tlSecondary,
      scrub: true,
    });
  }, section);
</script>
