---

---

<section data-politics-section class="pb-12">
  <div class="container mx-auto h-full md:px-0 px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-32 h-full">
      <div
        data-about-image
        class="aspect-square w-full bg-neutral-300 rounded-xl"
      >
      </div>
      <div class="flex justify-center flex-col">
        <h2
          data-about-heading
          class="text-3xl md:text-5xl font-bold mb-2 text-neutral-600"
        >
          Politicas
        </h2>

        <p data-about-body class="text-pretty mb-6">
          <span class="text-xs block mb-6"
            >AUDITORÍA DE RENOVACIÓN CERTIFICACIÓN ISO 9001:2015</span
          >
          MOVIGAS S.R.L. comprometida con el medio ambiente, seguridad y salud en
          el trabajo. Cuenta con sistema de gestión de calidad norma internacional
          ISO 9001: 2015.
        </p>

        <a
          data-politics-cta
          href="/politicas"
          class="mt-6 inline-block bg-neutral-50 border border-neutral-900 text-sm px-6 py-3 w-max font-bold text-neutral-950 hover:text-red-700 transition-colors"
        >
          Ver nuestras politicas
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, SplitText } from "../../lib/gsap";
  import { animateHeading } from "../../lib/animations";

  const section = document.querySelector(
    "[data-politics-section]",
  ) as HTMLElement;

  gsap.context(() => {
    const headingEl = section.querySelector(
      "[data-about-heading]",
    ) as HTMLElement;
    const bodyEl = section.querySelector("[data-about-body]") as HTMLElement;
    const imageEl = section.querySelector("[data-about-image]") as HTMLElement;
    const items = gsap.utils.toArray<HTMLElement>("[data-politics-item]");
    const ctaEl = section.querySelector("[data-politics-cta]") as HTMLElement;

    const splitBody = new SplitText(bodyEl, { type: "lines" });

    gsap.set(imageEl, { opacity: 0, x: -24 });
    gsap.set(splitBody.lines, { opacity: 0 });
    gsap.set(items, { opacity: 0, x: 16 });
    gsap.set(ctaEl, { opacity: 0, y: 8 });

    const tlImage = gsap.timeline({ paused: true });

    tlImage.to(imageEl, { opacity: 1, x: 0, duration: 1, ease: "power3.out" });

    ScrollTrigger.create({
      trigger: section,
      start: "top 70%",
      end: "top 30%",
      animation: tlImage,
      scrub: true,
    });

    const tlHeading = gsap.timeline({ paused: true });

    animateHeading(headingEl, tlHeading, { stagger: 0.03 });

    ScrollTrigger.create({
      trigger: section,
      start: "top 70%",
      end: "top 30%",
      animation: tlHeading,
      scrub: true,
    });

    const tlBody = gsap.timeline({ paused: true });

    tlBody
      .to(splitBody.lines, {
        opacity: 1,
        duration: 0.5,
        stagger: 0.08,
        ease: "power2.out",
      })
      .to(
        items,
        {
          opacity: 1,
          x: 0,
          duration: 0.4,
          stagger: 0.08,
          ease: "power2.out",
        },
        "-=0.2",
      )
      .to(
        ctaEl,
        { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" },
        "-=0.1",
      );

    ScrollTrigger.create({
      trigger: bodyEl,
      start: "top 80%",
      end: "bottom 60%",
      animation: tlBody,
      scrub: true,
    });
  }, section);
</script>
