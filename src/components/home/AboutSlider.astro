---
import SliderDots from "./SliderDots.astro";
import type { Slide } from "../../types/slider";

const slides: Slide[] = [
  {
    src: "https://res.cloudinary.com/dkgnaegp9/image/upload/v1787152638/DSC01157_cilgw3.jpg",
    alt: "Nosotros Movigas",
  },
  {
    src: "https://res.cloudinary.com/dkgnaegp9/image/upload/v1787152638/DSC01095_buj43w.jpg",
    alt: "Camión Movigas",
  },
  {
    src: "https://res.cloudinary.com/dkgnaegp9/image/upload/v1787152638/DJI_20260807105711_0086_D_jilwl7.jpg",
    alt: "Fotografia area flota camiones Movigas",
  },
];
---

<div
  data-about-image
  class="relative aspect-square w-full rounded-xl shadow-md"
>
  <div data-about-swiper class="swiper h-full w-full">
    <div class="swiper-wrapper h-full">
      {
        slides.map((slide) => (
          <div class="swiper-slide h-full">
            <img
              src={slide.src}
              alt={slide.alt}
              class="h-full w-full object-cover rounded-md"
            />
          </div>
        ))
      }
    </div>
  </div>
  <div class="absolute bottom-4 left-0 right-0 z-10">
    <SliderDots count={slides.length} />
  </div>
</div>

<script>
  import Swiper from "swiper";
  import { Autoplay } from "swiper/modules";
  import "swiper/css";

  const swiperEl = document.querySelector("[data-about-swiper]") as HTMLElement;
  const dotsContainer = document.querySelector(
    "[data-slider-dots]",
  ) as HTMLElement;
  const dots = Array.from(
    dotsContainer.querySelectorAll<HTMLElement>("[data-dot]"),
  );

  function updateDots(index: number) {
    dots.forEach((dot, i) => {
      if (i === index) {
        dot.classList.remove("w-2", "bg-white/50");
        dot.classList.add("w-8", "bg-white");
      } else {
        dot.classList.remove("w-8", "bg-white");
        dot.classList.add("w-2", "bg-white/50");
      }
    });
  }

  const swiper = new Swiper(swiperEl, {
    modules: [Autoplay],
    autoplay: {
      delay: 3000,
      disableOnInteraction: false,
    },
    speed: 1000,
    slidesPerView: 1,
    spaceBetween: 6,
    loop: true,
    on: {
      slideChange(s) {
        updateDots(s.activeIndex);
      },
    },
  });

  dots.forEach((dot) => {
    dot.addEventListener("click", () => {
      const index = Number(dot.dataset.dot);
      swiper.slideTo(index);
    });
  });
</script>

<style>
  [data-about-swiper] .swiper-wrapper {
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>
