---
import { navItems } from "../../data/navItems";

interface Props {
  hideNav?: boolean;
}

const { hideNav = false } = Astro.props;

const contactInfo = [
  {
    label: "Dirección",
    value: "Av. Pres. Perón 6855, 2000 Rosario, Santa Fe",
    icon: "location",
  },
  {
    label: "Contacto comercial",
    value: "info@movigas.com.ar · +54 341 5 070 416",
    icon: "mail",
  },
  {
    label: "Logística y transporte",
    value: "logistica@movigas.com.ar · +54 9 11 56127747",
    icon: "phone",
  },
];

const extensions = [
  { ext: "#111", desc: "Gestiones bancarias y cobranzas" },
  { ext: "#112", desc: "Logística y transporte nacional e internacional" },
  { ext: "#113", desc: "Atención y pago a proveedores" },
  { ext: "#114", desc: "Administración Contable y RRHH" },
  { ext: "#116", desc: "Amoníaco y solución amoniacal" },
  { ext: "#130", desc: "Administración" },
];
---

<footer class="bg-neutral-900 text-neutral-400">
  <!-- Main footer content -->
  <div class="container mx-auto px-6 py-16">
    <div
      class={`grid grid-cols-1 gap-12 ${hideNav ? "md:grid-cols-3" : "md:grid-cols-2 lg:grid-cols-4"}`}
    >
      <!-- Col 1: Brand -->
      <div class="flex flex-col gap-5">
        <a href="/" class="text-white text-2xl font-bold tracking-tight">
          MoviGas
        </a>
        <p class="text-sm leading-relaxed">
          Empresa familiar fundada en 1958, dedicada al transporte y
          distribución de sustancias peligrosas con más de 60 años de
          trayectoria nacional e internacional.
        </p>
        <div class="flex items-center gap-4 mt-1">
          <!-- Instagram -->
          <a href="#" aria-label="Instagram" class="hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <!-- Facebook -->
          <a href="#" aria-label="Facebook" class="hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
          <!-- X / Twitter -->
          <a href="#" aria-label="Twitter" class="hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation (optional) -->
      {
        !hideNav && (
          <div class="flex flex-col gap-5">
            <h3 class="text-white text-sm font-semibold uppercase tracking-widest">
              Navegación
            </h3>
            <ul class="flex flex-col gap-3">
              {navItems.map((link) => (
                <li>
                  <a href={link.href} class="text-sm hover:text-white transition-colors">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <!-- Col 3: Contact -->
      <div class="flex flex-col gap-5">
        <h3 class="text-white text-sm font-semibold uppercase tracking-widest">
          Contacto
        </h3>
        <ul class="flex flex-col gap-4">
          {
            contactInfo.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 shrink-0 text-neutral-500">
                  {item.icon === "location" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                      <circle cx="12" cy="10" r="3" />
                    </svg>
                  )}
                  {item.icon === "phone" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.6 3.38 2 2 0 0 1 3.56 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.74a16 16 0 0 0 6 6l.9-.9a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                    </svg>
                  )}
                  {item.icon === "mail" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                      <polyline points="22,6 12,13 2,6" />
                    </svg>
                  )}
                </span>
                <div>
                  <p class="text-xs text-neutral-500 mb-0.5">{item.label}</p>
                  <p class="text-sm text-neutral-300">{item.value}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 4: Extensions -->
      <div class="flex flex-col gap-5">
        <h3 class="text-white text-sm font-semibold uppercase tracking-widest">
          Internos
        </h3>
        <p class="text-xs text-neutral-500 -mt-2">Tel. +54 9 3415 21-4994 · Líneas rotativas</p>
        <ul class="flex flex-col gap-2">
          {
            extensions.map((item) => (
              <li class="flex items-start gap-3 border-b border-neutral-800 pb-2 last:border-0">
                <span class="text-xs font-mono text-red-500 shrink-0 mt-0.5">{item.ext}</span>
                <span class="text-sm">{item.desc}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-neutral-800">
    <div class="container mx-auto px-6 py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-neutral-600">
        &copy; {new Date().getFullYear()} MoviGas SRL. Todos los derechos reservados.
      </p>
      <p class="text-xs text-neutral-600">
        Empresa fundada en 1958 · Capital 100% nacional
      </p>
    </div>
  </div>
</footer>
