---
import { navItems } from "../../data/navItems";
import Logo from "./Logo.astro";

interface Props {
  hideNav?: boolean;
}

const { hideNav = false } = Astro.props;

const contactInfo = [
  {
    label: "Dirección",
    value: "Av. Pres. Perón 6855, 2000 Rosario, Santa Fe",
    icon: "location",
  },
  {
    label: "Contacto comercial",
    value: "info@movigas.com.ar · +54 341 5 070 416",
    icon: "mail",
  },
  {
    label: "Logística y transporte",
    value: "logistica@movigas.com.ar · +54 9 11 56127747",
    icon: "phone",
  },
];

const extensions = [
  { ext: "#111", desc: "Gestiones bancarias y cobranzas" },
  { ext: "#112", desc: "Logística y transporte nacional e internacional" },
  { ext: "#113", desc: "Atención y pago a proveedores" },
  { ext: "#114", desc: "Administración Contable y RRHH" },
  {
    ext: "#116",
    desc: "Atención y pago a proveedores. Lun. Miér. y Vie. 9 a 12 hs.",
  },
  { ext: "#119", desc: "Administracion logistica" },
  { ext: "#130", desc: "Administración. Lun-Vie. 9 a 15 hs." },
];
---

<footer class="bg-neutral-900 text-neutral-400">
  <!-- Main footer content -->
  <div class="container mx-auto px-6 py-16">
    <div
      class={`grid grid-cols-1 gap-12 ${hideNav ? "md:grid-cols-3" : "md:grid-cols-2 lg:grid-cols-4"}`}
    >
      <!-- Col 1: Brand -->
      <div class="flex flex-col gap-5">
        <a href="/" class="text-white">
          <Logo class="h-8 w-auto" />
        </a>
        <p class="text-sm leading-relaxed">
          Empresa familiar fundada en 1958, dedicada al transporte y
          distribución de sustancias peligrosas con más de 60 años de
          trayectoria nacional e internacional.
        </p>
        <div class="flex items-center gap-4 mt-1">
          <!-- LinkedIn -->
          <a
            href="#"
            aria-label="LinkedIn"
            class="opacity-90 hover:opacity-100 transition-opacity"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 72 72"
            >
              <path
                d="M8,72 L64,72 C68.418278,72 72,68.418278 72,64 L72,8 C72,3.581722 68.418278,-8.11624501e-16 64,0 L8,0 C3.581722,8.11624501e-16 -5.41083001e-16,3.581722 0,8 L0,64 C5.41083001e-16,68.418278 3.581722,72 8,72 Z"
                fill="#000000"
              ></path>
              <path
                d="M62,62 L51.315625,62 L51.315625,43.8021149 C51.315625,38.8127542 49.4197917,36.0245323 45.4707031,36.0245323 C41.1746094,36.0245323 38.9300781,38.9261103 38.9300781,43.8021149 L38.9300781,62 L28.6333333,62 L28.6333333,27.3333333 L38.9300781,27.3333333 L38.9300781,32.0029283 C38.9300781,32.0029283 42.0260417,26.2742151 49.3825521,26.2742151 C56.7356771,26.2742151 62,30.7644705 62,40.051212 L62,62 Z M16.349349,22.7940133 C12.8420573,22.7940133 10,19.9296567 10,16.3970067 C10,12.8643566 12.8420573,10 16.349349,10 C19.8566406,10 22.6970052,12.8643566 22.6970052,16.3970067 C22.6970052,19.9296567 19.8566406,22.7940133 16.349349,22.7940133 Z M11.0325521,62 L21.769401,62 L21.769401,27.3333333 L11.0325521,27.3333333 L11.0325521,62 Z"
                fill="#FFFFFF"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation (optional) -->
      {
        !hideNav && (
          <div class="flex flex-col gap-5">
            <h3 class="text-white text-sm font-semibold uppercase tracking-widest">
              Navegación
            </h3>
            <ul class="flex flex-col gap-3">
              {navItems.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm hover:text-white transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <!-- Col 3: Contact -->
      <div class="flex flex-col gap-5">
        <h3 class="text-white text-sm font-semibold uppercase tracking-widest">
          Contacto
        </h3>
        <ul class="flex flex-col gap-4">
          {
            contactInfo.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 shrink-0 text-neutral-500">
                  {item.icon === "location" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                      <circle cx="12" cy="10" r="3" />
                    </svg>
                  )}
                  {item.icon === "phone" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.6 3.38 2 2 0 0 1 3.56 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.74a16 16 0 0 0 6 6l.9-.9a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                    </svg>
                  )}
                  {item.icon === "mail" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                      <polyline points="22,6 12,13 2,6" />
                    </svg>
                  )}
                </span>
                <div>
                  <p class="text-xs text-neutral-500 mb-0.5">{item.label}</p>
                  <p class="text-sm text-neutral-300">{item.value}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 4: Extensions -->
      <div class="flex flex-col gap-5">
        <h3 class="text-white text-sm font-semibold uppercase tracking-widest">
          Internos
        </h3>
        <p class="text-xs text-neutral-500 -mt-2">
          Tel. +54 9 3415 21-4994 · Líneas rotativas
        </p>
        <ul class="flex flex-col gap-2">
          {
            extensions.map((item) => (
              <li class="flex items-start gap-3 border-b border-neutral-800 pb-2 last:border-0">
                <span class="text-xs font-mono text-red-500 shrink-0 mt-0.5">
                  {item.ext}
                </span>
                <span class="text-sm">{item.desc}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-neutral-800">
    <div
      class="container mx-auto px-6 py-5 flex flex-col sm:flex-row items-center justify-between gap-3"
    >
      <p class="text-xs text-neutral-600">
        &copy; {new Date().getFullYear()} MoviGas SRL. Todos los derechos reservados.
      </p>
      <p class="text-xs text-neutral-600">
        Empresa fundada en 1958 · Capital 100% nacional
      </p>
    </div>
  </div>
</footer>
