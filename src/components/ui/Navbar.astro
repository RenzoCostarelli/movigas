---
import { navItems } from "../../data/navItems";
import Logo from "./Logo.astro";
---

<header
  data-navbar
  class="sticky top-0 left-0 right-0 z-50 py-5 px-8 text-neutral-700"
>
  <nav class="flex items-center justify-between container mx-auto">
    <!-- Logo -->
    <a data-navbar-logo href="#" class="z-50 relative text-neutral-900">
      <Logo class="h-8 w-auto" />
    </a>

    <!-- Desktop: Nav links + Social icons -->
    <div class="hidden md:flex items-center gap-10">
      <!-- Navigation Links -->
      <ul class="flex items-center gap-8">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link text-sm font-bold hover:text-red-900 transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Divider -->
      <div data-nav-divider class="w-px h-4 bg-neutral-300"></div>

      <!-- Social Icons -->
      <div class="flex items-center gap-4">
        <!-- LinkedIn -->
        <a
          href="#"
          class="social-icon opacity-90 hover:opacity-100 transition-opacity"
          aria-label="LinkedIn"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 72 72"
          >
            <path
              d="M8,72 L64,72 C68.418278,72 72,68.418278 72,64 L72,8 C72,3.581722 68.418278,-8.11624501e-16 64,0 L8,0 C3.581722,8.11624501e-16 -5.41083001e-16,3.581722 0,8 L0,64 C5.41083001e-16,68.418278 3.581722,72 8,72 Z"
              fill="#FFFFFF"
            ></path>
            <path
              d="M62,62 L51.315625,62 L51.315625,43.8021149 C51.315625,38.8127542 49.4197917,36.0245323 45.4707031,36.0245323 C41.1746094,36.0245323 38.9300781,38.9261103 38.9300781,43.8021149 L38.9300781,62 L28.6333333,62 L28.6333333,27.3333333 L38.9300781,27.3333333 L38.9300781,32.0029283 C38.9300781,32.0029283 42.0260417,26.2742151 49.3825521,26.2742151 C56.7356771,26.2742151 62,30.7644705 62,40.051212 L62,62 Z M16.349349,22.7940133 C12.8420573,22.7940133 10,19.9296567 10,16.3970067 C10,12.8643566 12.8420573,10 16.349349,10 C19.8566406,10 22.6970052,12.8643566 22.6970052,16.3970067 C22.6970052,19.9296567 19.8566406,22.7940133 16.349349,22.7940133 Z M11.0325521,62 L21.769401,62 L21.769401,27.3333333 L11.0325521,27.3333333 L11.0325521,62 Z"
              fill="#000000"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Mobile: Hamburger button -->
    <button
      data-menu-toggle
      aria-label="Abrir menú"
      aria-expanded="false"
      class="md:hidden relative z-50 flex flex-col justify-center items-center w-8 h-8 gap-1.5"
    >
      <span
        data-bar-1
        class="block w-6 h-0.5 bg-neutral-900 transition-all duration-300 origin-center"
      ></span>
      <span
        data-bar-2
        class="block w-6 h-0.5 bg-neutral-900 transition-all duration-300"
      ></span>
      <span
        data-bar-3
        class="block w-6 h-0.5 bg-neutral-900 transition-all duration-300 origin-center"
      ></span>
    </button>
  </nav>

  <!-- Mobile menu overlay -->
  <div
    data-mobile-menu
    class="md:hidden fixed inset-0 bg-white z-40 flex flex-col justify-center px-8 opacity-0 pointer-events-none transition-opacity duration-300"
  >
    <ul class="flex flex-col gap-8 mb-12">
      {
        navItems.map((item) => (
          <li>
            <a
              data-mobile-link
              href={item.href}
              class="text-3xl font-bold text-neutral-900 hover:text-red-900 transition-colors"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="border-t border-neutral-200 pt-8">
      <p class="text-xs text-neutral-400 uppercase tracking-widest mb-4">
        Seguinos
      </p>
      <div class="flex items-center gap-6">
        <a
          href="#"
          aria-label="LinkedIn"
          class="opacity-90 hover:opacity-100 transition-opacity"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 72 72"
          >
            <path
              d="M8,72 L64,72 C68.418278,72 72,68.418278 72,64 L72,8 C72,3.581722 68.418278,-8.11624501e-16 64,0 L8,0 C3.581722,8.11624501e-16 -5.41083001e-16,3.581722 0,8 L0,64 C5.41083001e-16,68.418278 3.581722,72 8,72 Z"
              fill="#FFFFFF"
            ></path>
            <path
              d="M62,62 L51.315625,62 L51.315625,43.8021149 C51.315625,38.8127542 49.4197917,36.0245323 45.4707031,36.0245323 C41.1746094,36.0245323 38.9300781,38.9261103 38.9300781,43.8021149 L38.9300781,62 L28.6333333,62 L28.6333333,27.3333333 L38.9300781,27.3333333 L38.9300781,32.0029283 C38.9300781,32.0029283 42.0260417,26.2742151 49.3825521,26.2742151 C56.7356771,26.2742151 62,30.7644705 62,40.051212 L62,62 Z M16.349349,22.7940133 C12.8420573,22.7940133 10,19.9296567 10,16.3970067 C10,12.8643566 12.8420573,10 16.349349,10 C19.8566406,10 22.6970052,12.8643566 22.6970052,16.3970067 C22.6970052,19.9296567 19.8566406,22.7940133 16.349349,22.7940133 Z M11.0325521,62 L21.769401,62 L21.769401,27.3333333 L11.0325521,27.3333333 L11.0325521,62 Z"
              fill="#000000"
            ></path>
          </svg>
        </a>
      </div>

      <p class="text-sm text-neutral-400 mt-8">+54 (11) 4321-0000</p>
      <p class="text-sm text-neutral-400">info@movigas.com.ar</p>
    </div>
  </div>
</header>

<script>
  import { gsap } from "../../lib/gsap";

  const header = document.querySelector("[data-navbar]") as HTMLElement;
  const toggle = document.querySelector(
    "[data-menu-toggle]",
  ) as HTMLButtonElement;
  const menu = document.querySelector("[data-mobile-menu]") as HTMLElement;
  const bar1 = document.querySelector("[data-bar-1]") as HTMLElement;
  const bar2 = document.querySelector("[data-bar-2]") as HTMLElement;
  const bar3 = document.querySelector("[data-bar-3]") as HTMLElement;
  const mobileLinks = document.querySelectorAll("[data-mobile-link]");

  // ── Desktop nav entrance animation ────────────────────────────────────────
  const navLinks = document.querySelectorAll(".nav-link");
  // const socialIcons = document.querySelectorAll(".social-icon");
  // const divider = document.querySelector("[data-nav-divider]");

  gsap.set([navLinks], { opacity: 0, y: -12 });

  gsap.to(navLinks, {
    opacity: 1,
    y: 0,
    duration: 0.45,
    stagger: 0.08,
    ease: "power3.out",
    delay: 0.2,
  });

  // ── Scroll: white background after 20% viewport height ────────────────────
  let isScrolled = false;

  function onScroll() {
    const shouldBeScrolled = window.scrollY >= window.innerHeight * 0.2;
    if (shouldBeScrolled && !isScrolled) {
      isScrolled = true;
      gsap.to(header, {
        backgroundColor: "rgba(255,255,255,1)",
        boxShadow: "0 1px 16px 0 rgba(0,0,0,0.07)",
        duration: 0.35,
        ease: "power2.out",
      });
    } else if (!shouldBeScrolled && isScrolled) {
      isScrolled = false;
      gsap.to(header, {
        backgroundColor: "rgba(255,255,255,0)",
        boxShadow: "0 0px 0px 0 rgba(0,0,0,0)",
        duration: 0.35,
        ease: "power2.out",
      });
    }
  }

  window.addEventListener("scroll", onScroll, { passive: true });

  // ── Mobile menu ───────────────────────────────────────────────────────────
  let isOpen = false;

  function openMenu() {
    isOpen = true;
    toggle.setAttribute("aria-expanded", "true");
    menu.classList.remove("pointer-events-none");

    gsap.to(menu, { opacity: 1, duration: 0.3, ease: "power2.out" });
    gsap.to(mobileLinks, {
      opacity: 1,
      y: 0,
      duration: 0.4,
      stagger: 0.07,
      ease: "power3.out",
      delay: 0.1,
    });

    // Animate hamburger → X
    gsap.to(bar1, { rotate: 45, y: 8, duration: 0.3, ease: "power2.out" });
    gsap.to(bar2, { opacity: 0, duration: 0.15 });
    gsap.to(bar3, { rotate: -45, y: -8, duration: 0.3, ease: "power2.out" });
  }

  function closeMenu() {
    isOpen = false;
    toggle.setAttribute("aria-expanded", "false");

    gsap.to(menu, {
      opacity: 0,
      duration: 0.25,
      ease: "power2.in",
      onComplete: () => menu.classList.add("pointer-events-none"),
    });

    // Animate X → hamburger
    gsap.to(bar1, { rotate: 0, y: 0, duration: 0.3, ease: "power2.out" });
    gsap.to(bar2, { opacity: 1, duration: 0.3 });
    gsap.to(bar3, { rotate: 0, y: 0, duration: 0.3, ease: "power2.out" });
  }

  // Set initial state for mobile links
  gsap.set(mobileLinks, { opacity: 0, y: 20 });

  toggle.addEventListener("click", () => {
    if (isOpen) closeMenu();
    else openMenu();
  });

  // Close menu on link click
  mobileLinks.forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
</script>
